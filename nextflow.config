params {
    // Input
    metadata  = 'data/metadata.csv'
    tx2gene   = 'results/star_salmon/salmon.merged.tx2gene.tsv'
    quant_dir = 'results/star_salmon'

    ensembl_version = 115
    species         = 'human'

    // DESeq2
    deseq2_design        = 'group'
    deseq2_min_count     = 10
    deseq2_max_zero_frac = 0.5
    deseq2_alpha         = 0.05
    deseq2_lfc_threshold = 0

    // Quant QC: one PCA panel per metadata column, comma separated
    qc_fill               = 'group,season,year'
    qc_ntop               = 500

    // Gene plots: top genes per contrast (0 = every significant gene), and an
    // optional annotation csv/tsv (gene_id, gene_name, chr, start, end,
    // gene_type, description)
    gene_plots_top_n      = 0
    gene_annotation       = null
    gene_plots_labels     = false

    // Output
    outdir           = 'analysis'
    publish_dir_mode = 'copy'
}

// Fail a task when any command in a pipe fails (e.g. Rscript | tee)
process.shell = ['/bin/bash', '-euo', 'pipefail']

profiles {
  
    local {
        process {
            executor = 'local'
        }
    }

    apptainer {
        apptainer {
            enabled = true
            autoMounts = true
            pullTimeout = '3h'
        }
        conda.enabled = false
        docker.enabled = false
        singularity.enabled = false
    }

    conda {
        apptainer.enabled = false
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }

    docker {
        apptainer.enabled = false
        conda.enabled = false
        docker.enabled = true
        singularity.enabled = false
    }

    singularity {
        apptainer.enabled = false
        conda.enabled = false
        docker.enabled = false
        singularity {
            enabled = true
            autoMounts = true
            pullTimeout = '3h'
        }
    }

    test {
        process {
            memory = 4.GB
            cpus = 1
        }
    }

    uppmax {
        singularity {
            enabled = true
            autoMounts = true
            pullTimeout = '3h'
            runOptions = '--bind /gorilla'
        }

        process {
            memory = 6.GB
            time = 1.h
            executor = 'slurm'
            clusterOptions = "-A ${params.project}"
            scratch = true
        }
    }
}

includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'
