process {

    withName: 'BIOMART_ANNOTATION' {
        // Ensembl's servers time out now and then: retry after 30 s, 60 s
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 15000 as long); 'retry' }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'QUANT_QC' {
        ext.prefix = 'quant_qc'
        ext.args = { [
            "--fill '${params.qc_fill}'",
            "--ntop ${params.qc_ntop}"
        ].join(' ') }
        publishDir = [
            [
                path: { "${params.outdir}/quant_qc" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv}'
            ],
            [
                path: { "${params.outdir}/manuscript/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.{pdf}'
            ]
        ]
    }

    withName: 'DESEQ2_DDS' {
        ext.args = { [
            "--design '${params.deseq2_design}'",
            "--min_count ${params.deseq2_min_count}",
            "--max_zero_frac ${params.deseq2_max_zero_frac}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/deseq2" },
            mode: params.publish_dir_mode,
            pattern: '*.{Rds,log}'
        ]
    }

    withName: 'DESEQ2_GENE_PLOTS' {
        ext.args = { [
            "--alpha ${params.deseq2_alpha}",
            "--top_n ${params.gene_plots_top_n}",
            "--gene_plots_labels ${params.gene_plots_labels}"
        ].join(' ') }
        publishDir = [
            [
                path: { "${params.outdir}/deseq2" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv}'
            ],
            [
                path: { "${params.outdir}/manuscript/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.{pdf}'
            ]
        ]
    }

    withName: 'DESEQ2_RESULTS' {
        ext.args = { [
            "--alpha ${params.deseq2_alpha}",
            "--lfc_threshold ${params.deseq2_lfc_threshold}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/deseq2/results" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName: 'PATHWAY_ENRICHMENT_ORA' {
        ext.args = { [
            "--species ${params.species}",
            "--databases ${params.enrichment_databases}",
            "--gene_alpha ${params.deseq2_alpha}",
            "--alpha ${params.enrichment_alpha}",
            "--min_count ${params.enrichment_min_count}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/pathway_enrichment" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'QUARTO_REPORT' {
        ext.prefix = 'results_transcriptome'
        ext.args = { params.report_export_fig ? '-P export_fig:true' : '' }
        publishDir = [
            path: { "${params.outdir}/report" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }
}
