process {

    withName:SAMPLE_QC_METRICS {
        ext.args = { [
            "--sample_col ${params.sample_qc_sample_col}",
            // `--sample_prefix ''` on the command line arrives as `true`
            "--sample_prefix '${params.sample_prefix == true ? '' : params.sample_prefix}'",
            "--columns '${params.sample_qc_columns == true ? '' : params.sample_qc_columns}'",
            "--ntop ${params.sample_qc_ntop}",
            "--min_count ${params.sample_qc_min_count}",
            "--mad ${params.sample_qc_mad}"
        ].join(' ') }
        publishDir = [
            path:   { "${params.outdir}" },
            mode:   params.publish_dir_mode,
            saveAs: { foo ->
                if ( foo == 'versions.yml' )        return null
                if ( foo ==~ /.*\.(tsv|Rds|log)$/ ) return "sample_qc/${foo}"
                return null
            }
        ]
    }

    withName:SAMPLE_QC_REPORT {
        ext.args = { params.sample_qc_group ? "-P group:${params.sample_qc_group}" : '' }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { foo ->
                if ( foo == 'versions.yml' )  return null
                if () foo ==~ /.*\.(html)$/ ) return "sample_qc/${foo}"
                return null
            }
        ]
    }


    withName: 'BIOMART_ANNOTATION' {
        // Ensembl's servers time out now and then: retry after 30 s, 60 s
        errorStrategy = { sleep(Math.pow(2, task.attempt) * 15000 as long); 'retry' }
        maxRetries = 2
        publishDir = [
            path: { "${params.outdir}/annotation" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName: 'QUANT_QC' {
        ext.prefix = 'quant_qc'
        ext.args = { [
            "--fill '${params.qc_fill}'",
            "--ntop ${params.qc_ntop}"
        ].join(' ') }
        publishDir = [
            [
                path: { "${params.outdir}/quant_qc" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv}'
            ],
            [
                path: { "${params.outdir}/manuscript/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.{pdf}'
            ]
        ]
    }

    withName: 'DESEQ2_DDS' {
        ext.args = { [
            "--design '${params.deseq2_design}'",
            "--min_count ${params.deseq2_min_count}",
            "--max_zero_frac ${params.deseq2_max_zero_frac}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/deseq2" },
            mode: params.publish_dir_mode,
            pattern: '*.{Rds,log}'
        ]
    }

    withName:DESEQ2_GENE_PLOTS {
        ext.args = { [
            "--alpha ${params.deseq2_alpha}",
            "--top_n ${params.gene_plots_top_n}",
            "--gene_plots_labels ${params.gene_plots_labels}"
        ].join(' ') }
        publishDir = [
            [
                path: { "${params.outdir}/deseq2" },
                mode: params.publish_dir_mode,
                pattern: '*.{tsv}'
            ],
            [
                path: { "${params.outdir}/manuscript/figures" },
                mode: params.publish_dir_mode,
                pattern: '*.{pdf}'
            ]
        ]
    }

    withName: 'DESEQ2_RESULTS' {
        ext.args = { [
            "--alpha ${params.deseq2_alpha}",
            "--lfc_threshold ${params.deseq2_lfc_threshold}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/deseq2/results" },
            mode: params.publish_dir_mode,
            pattern: '*.tsv'
        ]
    }

    withName:PATHWAY_ENRICHMENT_ORA {
        ext.when = { 'ora' in params.enrichment_methods.tokenize(',')*.trim() }
        ext.args = { [
            "--species ${params.species}",
            "--databases ${params.enrichment_databases}",
            "--gene_alpha ${params.deseq2_alpha}",
            "--alpha ${params.enrichment_alpha}",
            "--min_count ${params.enrichment_min_count}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/pathway_enrichment/ora" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName:PATHWAY_ENRICHMENT_GSEA {
        ext.when = { 'gsea' in params.enrichment_methods.tokenize(',')*.trim() }
        ext.args = { [
            "--species ${params.species}",
            "--databases ${params.enrichment_databases}",
            "--rank_by ${params.gsea_rank_by}",
            "--alpha ${params.enrichment_alpha}",
            "--min_size ${params.gsea_min_size}",
            "--max_size ${params.gsea_max_size}",
            "--seed ${params.gsea_seed}"
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/pathway_enrichment/gsea" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename == 'versions.yml' ? null : filename }
        ]
    }

    withName:QUARTO_REPORT {
        ext.prefix = 'results_transcriptome'
        ext.args = { params.quarto_export_fig ? '-P export_fig:true' : '' }
        publishDir = [
            path: { "${params.outdir}" },
            mode: params.publish_dir_mode,
            saveAs: { fn ->
                if (fn == 'versions.yml') return null
                if (fn.endsWith('.html')) return "report/${fn}"
                if (fn ==~ /.*\.(pdf|txt)/) return "manuscript/${fn}"
                return fn
            }
        ]
    }
}